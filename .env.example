# OpenRouter API key — get one at https://openrouter.ai/keys
# If left empty, the simulation runs with rule-based fallback only.
OPENROUTER_API_KEY=

# Which model to use for narrative decisions.
# Cheap & fast options: google/gemini-2.5-flash, qwen/qwen-3-8b, google/gemma-3-12b-it
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: your site URL & app name (OpenRouter analytics)
OPENROUTER_SITE_URL=https://github.com/leatag/emergent-city
OPENROUTER_APP_NAME=EmergentCity
